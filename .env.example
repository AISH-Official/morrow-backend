# OpenAI Responses API. Keep secrets in local .env or the deployment secret store.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_SHORT_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5.6-luna
OPENAI_ENABLED=false

# Share consented, derived HealthKit summaries with the AI context.
MORROW_AI_INCLUDE_HEALTH_DATA=false

# KST is the product default for calendar grouping and displayed event times.
MORROW_TIME_ZONE=Asia/Seoul

# Require the device-scoped Bearer tokens issued by /api/v1/auth/device.
# Keep false for the seeded local demo and enable in deployed environments.
MORROW_AUTH_REQUIRED=false

# Optional judge/demo credential route. Normal users sign in with account ID.
MORROW_DEMO_LOGIN_ENABLED=false
MORROW_DEMO_LOGIN_USERNAME=
MORROW_DEMO_LOGIN_PASSWORD=
MORROW_DEMO_LOGIN_USER_ID=hackathon-demo

# Swagger UI and the OpenAPI JSON document.
SWAGGER_ENABLED=true

# Apple Push Notification service token credentials.
# APNS_PRIVATE_KEY may contain the full .p8 PEM with escaped newlines, or use an absolute path.
APNS_ENABLED=false
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
APNS_IOS_TOPIC=com.qlsl1198.morrowwellness
APNS_WATCH_TOPIC=com.qlsl1198.morrowwellness.watchkitapp

# Proactive check-in notification schedule.
MORROW_CHECK_IN_REMINDERS_ENABLED=true
MORROW_CHECK_IN_CRON="0 0 * * * *"

# Minimum wellness load (100 - recovery score) before the AI judge evaluates
# a proactive recovery alert. Lower values let the AI weigh in earlier.
MORROW_AI_EVALUATION_MIN_LOAD=20

# Database Configuration (optional, defaults to H2)
# DATABASE_URL=jdbc:postgresql://localhost:5432/morrow
# DATABASE_USERNAME=morrow
# DATABASE_PASSWORD=morrow
